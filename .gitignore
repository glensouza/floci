## ---------------------------------------------------------------
## Secrets and local configuration
## ---------------------------------------------------------------
# NOTE: appsettings.Development.json IS committed on purpose — it holds the
# Floci emulator endpoints, which are not secrets. Only *.local.json is ignored.
appsettings.*.local.json
*.local.json
.env
.env.*
!.env.example
secrets.json

## ---------------------------------------------------------------
## Claude Code
## ---------------------------------------------------------------
# .claude/skills/ and .claude/settings.json ARE committed — they are how
# /next and /ship travel between machines. Only machine-local overrides
# and transient state are ignored.
.claude/settings.local.json
.claude/*.local.json

## ---------------------------------------------------------------
## Floci lab — local emulator state
## ---------------------------------------------------------------
# Emulator persistence when running Compose from a clone rather than
# named Docker volumes.
data/
init/files/*
!init/files/.gitkeep

