{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_readme": [
    "Copy this file to .claude/settings.json to reduce permission prompts for the",
    "/next and /ship workflow. It is version-controlled so the same config travels",
    "to every machine you work on.",
    "",
    "  cp docs/claude-settings.example.json .claude/settings.json",
    "",
    "Claude cannot install this itself — the harness blocks an agent from writing",
    "its own permission grants, which is the correct guardrail. Review it first.",
    "",
    "The ../floci-content rules assume it is cloned as a sibling directory, which",
    "it must be for /ship to work. If those relative paths do not take effect on",
    "your setup, run /permissions and re-add them — it writes the correct syntax",
    "for your platform automatically.",
    "",
    "git push is allowed; force pushes, hard resets and clean -fdx are denied.",
    "",
    "Machine-local overrides belong in .claude/settings.local.json (gitignored)."
  ],
  "permissions": {
    "allow": [
      "Bash(dotnet:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git branch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git stash:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git remote -v)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(gh pr:*)",
      "Bash(gh issue:*)",
      "Bash(python tools/sync-status.py:*)",
      "Bash(python3 tools/sync-status.py:*)",
      "Bash(curl -fsS http://localhost:4566/*)",
      "Bash(curl -fsS http://localhost:4577/*)",
      "Bash(curl -fsS http://localhost:4588/*)",
      "Bash(curl -fsS http://localhost:4599/*)",
      "Bash(curl -s http://localhost:45*)",
      "Bash(curl -s -i http://localhost:45*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose up:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker inspect:*)",
      "Bash(docker restart:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(mkdir:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(cat:*)",
      "Bash(diff:*)",
      "Bash(sort:*)",
      "Bash(echo:*)",
      "Bash(printf:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:floci.io)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:aspire.dev)",
      "WebFetch(domain:www.nuget.org)",
      "WebFetch(domain:docs.aws.amazon.com)",
      "WebFetch(domain:cloud.google.com)",
      "WebFetch(domain:docs.oracle.com)",

      "Read(../floci-content/**)",
      "Edit(../floci-content/**)",
      "Write(../floci-content/**)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Read(./**/*.pem)",
      "Read(./**/*.pfx)",
      "Read(./**/.env)",
      "Read(./**/secrets.json)"
    ]
  }
}
