<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Aws.ApiGatewayV2</RootNamespace>
  </PropertyGroup>

  <!--
    TWO official cloud packages — a deliberate, user-approved exception to the one-package rule
    (docs/BLAZOR-PLAN.md §3, constraint 1). AWS splits API Gateway v2 across two SDK packages:
    AWSSDK.ApiGatewayV2 is the control plane (CreateApi, CreateStage…), and
    AWSSDK.ApiGatewayManagementApi is the WebSocket data-plane callback API (PostToConnection,
    GetConnection, DeleteConnection) that a production backend uses to push to a connected client.
    The WebSocket demo cannot show a server-to-client push without it. Both are the packages a
    production app would reference, used as production would use them — the only difference is
    the endpoint, which comes from FlociLab.Aws.Endpoints. The client side of the socket is the
    BCL's ClientWebSocket, not a package.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.ApiGatewayV2" />
    <PackageReference Include="AWSSDK.ApiGatewayManagementApi" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\FlociLab.Aws.Endpoints\FlociLab.Aws.Endpoints.csproj" />
  </ItemGroup>

</Project>
