@page "/aws/cognito"
@inject CognitoDemo Demo
@inject CognitoClientFactory Factory
@implements IDisposable

<PageTitle>AWS Cognito — FlociLab</PageTitle>

<h1>AWS Cognito</h1>

<p class="lede">
    Create a user pool and an app client, add a user, sign in with a password, and ask Cognito whose
    access token that is. Then get the password wrong on purpose, self-register a second user and
    put the first in a group. This is <code>AWSSDK.CognitoIdentityProvider</code> used exactly as
    production would use it. Every run makes its own pool and deletes it at the end, which takes the
    users, client and group with it. Tokens and passwords are never rendered; only their lengths
    are.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci emulator" : "REAL AWS — this creates and deletes a live user pool")
    </dd>
    <dt>Endpoint</dt>
    <dd><code>@this.Factory.ServiceUrl</code></dd>
    <dt>Package</dt>
    <dd><code>AWSSDK.CognitoIdentityProvider</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the sign-in round trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching the sign-in succeed
            // before GetUser confirms whose token it is is most of the point.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. RunAsync's finally still deletes the user pool it created.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
