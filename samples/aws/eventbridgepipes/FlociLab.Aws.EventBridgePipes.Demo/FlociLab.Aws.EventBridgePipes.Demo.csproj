<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Aws.EventBridgePipes</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). AWSSDK.Pipes is the same
    package a production app would reference, used exactly as production would use it — the only
    difference is the endpoint, which comes from FlociLab.Aws.Endpoints. AWSSDK.Core arrives with
    it either way, so the endpoints project costs this sample nothing. Pipes needs a source and a
    target ARN it never touches directly (they belong to whatever service is being connected), so
    this sample never has to reference AWSSDK.SQS to demonstrate the pipe shape.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="AWSSDK.Pipes" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\FlociLab.Aws.Endpoints\FlociLab.Aws.Endpoints.csproj" />
  </ItemGroup>

</Project>
