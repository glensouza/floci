@page "/aws/sns"
@inject SnsDemo Demo
@inject SnsClientFactory Factory
@implements IDisposable

<PageTitle>Amazon SNS — FlociLab</PageTitle>

<h1>Amazon SNS</h1>

<p class="lede">
    Create a topic, subscribe an email address, confirm it's pending, publish a message, unsubscribe,
    delete the topic. This is <code>AWSSDK.SimpleNotificationService</code> used exactly as
    production would use it. Everything that differs sits in <code>SnsClientFactory</code>: the
    service URL and <code>MaxErrorRetry = 0</code> so the request shown under each step below is
    the only one that went out. Note the wire format — SNS is a <em>query-protocol</em> service, so
    that is form-encoded <code>Action=…</code> in and XML out, not the JSON and
    <code>X-Amz-Target</code> header its neighbour SQS uses. Publish never gets a wired-up
    subscriber here — a real one needs a second SDK, which the one-package-per-sample rule rules
    out — so the only receipt this page can show for a publish is the <code>MessageId</code> SNS
    itself returns.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci emulator" : "REAL AWS — this costs money")
    </dd>
    <dt>Endpoint</dt>
    <dd><code>@this.Factory.ServiceUrl</code></dd>
    <dt>Package</dt>
    <dd><code>AWSSDK.SimpleNotificationService</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching CreateTopic land
            // before Subscribe is most of the point of the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already cleaned the topic up.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
