<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Azure.Blob</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). Azure.Storage.Blobs is the
    same package a production app would reference, used exactly as production would use it — the
    only difference is the endpoint, which comes from FlociLab.Core's AzureEndpoints.

    No FlociLab.Azure.Endpoints reference, unlike the AWS sample's FlociLab.Aws.Endpoints. That
    project exists for the credential half of plan §7 and carries Azure.Identity with it, and the
    storage plane does not use a TokenCredential at all — it authenticates with the account key in
    the connection string. Taking the reference would hand this sample a package it never calls.
    The three other Azure planes (ARM, data plane, messaging) do need it.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Storage.Blobs" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
  </ItemGroup>

</Project>
