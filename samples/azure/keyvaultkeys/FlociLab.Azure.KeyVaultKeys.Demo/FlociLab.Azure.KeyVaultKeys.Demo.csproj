<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Azure.KeyVaultKeys</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). Azure.Security.KeyVault.Keys
    is the same package a production app would reference, used exactly as production would use it —
    the only difference is the endpoint, which comes from FlociLab.Core's AzureEndpoints.

    Split from FlociLab.Azure.KeyVaultSecrets.Demo rather than one "Key Vault" sample: Secrets and
    Keys are separate NuGet packages, and constraint 1 allows exactly one per sample. Both samples
    target the same emulator vault.

    FlociLab.Azure.Endpoints reference for the same reason as the Secrets sample: Key Vault
    authenticates with a TokenCredential rather than an account key.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Security.KeyVault.Keys" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\FlociLab.Azure.Endpoints\FlociLab.Azure.Endpoints.csproj" />
  </ItemGroup>

</Project>
