<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Azure.KeyVaultSecrets</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). Azure.Security.KeyVault.Secrets
    is the same package a production app would reference, used exactly as production would use it —
    the only difference is the endpoint, which comes from FlociLab.Core's AzureEndpoints.

    FlociLab.Azure.Endpoints reference IS needed here, unlike Blob/Queue/Cosmos: Key Vault is the one
    Azure data plane in this repo that genuinely authenticates with a TokenCredential rather than an
    account key, so the sample needs AzureEndpoints.Credential() and the Azure.Identity package that
    project carries — the same "credential half" role AWSSDK.Core plays for every AWS sample, not a
    second cloud SDK.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\FlociLab.Azure.Endpoints\FlociLab.Azure.Endpoints.csproj" />
  </ItemGroup>

</Project>
