@page "/azure/keyvaultsecrets"
@inject KeyVaultSecretsDemo Demo
@inject KeyVaultSecretsClientFactory Factory
@implements IDisposable

<PageTitle>Azure Key Vault Secrets — FlociLab</PageTitle>

<h1>Azure Key Vault Secrets</h1>

<p class="lede">
    Set a secret, read it back, set a new version, read that back, then soft-delete and purge it.
    This is <code>Azure.Security.KeyVault.Secrets</code> used exactly as production would use it.
    Everything that differs sits in <code>KeyVaultSecretsClientFactory</code>: the vault URI, and
    the credential — Key Vault is the one Azure plane in this lab that genuinely authenticates with
    a <code>TokenCredential</code> rather than an account key, so the client uses a
    <code>ManagedIdentityCredential</code> against floci-az's own IMDS endpoint.
</p>

<p class="lede">
    Key Vault is split across two samples rather than one — see
    <a href="/azure/keyvaultkeys">Key Vault Keys</a>. <code>Azure.Security.KeyVault.Secrets</code>
    and <code>Azure.Security.KeyVault.Keys</code> are separate NuGet packages, and this lab's rule is
    one official cloud SDK package per sample.
</p>

<p class="lede">
    <strong>Every step below fails against floci-az today, for two separate reasons.</strong>
    Listing secrets 404s: the SDK requests <code>GET secrets/</code> (a trailing slash) for a list,
    and floci-az's router reads the empty segment after it as a secret name rather than "list
    everything". Every operation that returns a secret body fails afterward too — floci-az sends
    <code>attributes.nbf</code>/<code>attributes.exp</code> as JSON <code>null</code> when unset
    instead of omitting them, and the SDK's model insists on a number there. Real Key Vault would
    do neither. This page still runs the full intended round trip and shows exactly what floci-az
    says, so it becomes the tripwire for the day either lands upstream.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci-az emulator" : "REAL Azure — this costs money")
    </dd>
    <dt>Endpoint</dt>
    <dd><code>@this.Factory.ServiceUrl</code></dd>
    <dt>Package</dt>
    <dd><code>Azure.Security.KeyVault.Secrets</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci-az
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching SetSecret land before
            // GetSecret is most of the point of the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already cleaned the secret up.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
