<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Azure.Queue</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). Azure.Storage.Queues is the
    same package a production app would reference, used exactly as production would use it — the
    only difference is the endpoint, which comes from FlociLab.Core's AzureEndpoints.

    No FlociLab.Azure.Endpoints reference, same reasoning as the Blob sample: Queue Storage
    authenticates with the account key in the connection string, not a TokenCredential, so the
    credential-plane package would never be called.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Storage.Queues" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
  </ItemGroup>

</Project>
