@page "/azure/queue"
@inject QueueDemo Demo
@inject QueueClientFactory Factory
@implements IDisposable

<PageTitle>Azure Queue Storage — FlociLab</PageTitle>

<h1>Azure Queue Storage</h1>

<p class="lede">
    Create a queue, send a message, receive it, delete it, delete the queue. This is
    <code>Azure.Storage.Queues</code> used exactly as production would use it. Everything that
    differs sits in <code>QueueClientFactory</code>: the connection string, which shares the same
    storage plane and IPv4-literal host as Blob Storage, and <code>MaxRetries = 0</code> so the
    request shown under each step below is the only one that went out.
</p>

@if (this.Factory.UseEmulator)
{
    @* Only true of floci-az. Against real Azure every step below is expected to *pass*, so this
       paragraph would be a flat lie on the one page whose promise is showing what really happened. *@
    <p class="lede">
        Every step below is expected to fail, and that failure is itself the finding. floci-az does
        not implement Queue Storage yet: <code>CreateQueue</code> and <code>DeleteQueue</code>
        answer a clean 501, but <code>ListQueues</code> answers 200 with the <em>blob</em> container
        listing instead of a queue list — a body the SDK's queue deserializer cannot parse, which
        throws client-side rather than reporting a clean error. Because <code>CreateQueue</code>
        never succeeds, the queue this run tries to use never exists, so every step after it answers
        404 <code>QueueNotFound</code>.
    </p>
}

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci-az emulator" : "REAL Azure — this costs money")
    </dd>
    <dt>Endpoint</dt>
    <dd><code>@this.Factory.ServiceUrl</code></dd>
    <dt>Package</dt>
    <dd><code>Azure.Storage.Queues</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what the endpoint
        above actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching CreateQueue land
            // before SendMessage is most of the point of the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already cleaned the queue up.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
