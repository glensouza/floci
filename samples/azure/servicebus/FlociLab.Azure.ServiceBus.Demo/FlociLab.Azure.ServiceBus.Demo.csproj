<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Azure.ServiceBus</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). Azure.Messaging.ServiceBus is
    the same package a production app would reference, used exactly as production would use it —
    the only difference is the endpoint, which comes from FlociLab.Core's AzureEndpoints.

    FlociLab.Azure.Endpoints reference IS needed, unlike Blob/Queue/Cosmos: real-cloud mode
    authenticates with a TokenCredential (AzureEndpoints.Credential()) rather than a connection
    string — see ServiceBusClientFactory. floci-az's own emulator mode instead relies on the SDK's
    UseDevelopmentEmulator connection-string flag, which needs no credential at all.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="Azure.Messaging.ServiceBus" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\FlociLab.Azure.Endpoints\FlociLab.Azure.Endpoints.csproj" />
  </ItemGroup>

</Project>
