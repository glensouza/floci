<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Gcp.Kms</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). Google.Cloud.Kms.V1 is the
    same package a production app would reference, used exactly as production would use it — the
    only difference is the endpoint, which comes from FlociLab.Gcp.Endpoints' FlociGcpExtensions.ForFloci.

    Cloud KMS is not one of the emulator-aware clients (plan §7 — only Pub/Sub, Firestore and
    Datastore honour *_EMULATOR_HOST), so this sample takes route 2: ForFloci against GrpcTarget
    directly, same as PubSubClientFactory, FirestoreClientFactory and SecretManagerClientFactory.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="Google.Cloud.Kms.V1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\FlociLab.Gcp.Endpoints\FlociLab.Gcp.Endpoints.csproj" />
  </ItemGroup>

</Project>
