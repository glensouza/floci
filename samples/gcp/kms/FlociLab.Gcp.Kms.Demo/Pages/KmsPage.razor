@page "/gcp/kms"
@inject KmsDemo Demo
@inject KmsClientFactory Factory
@implements IDisposable

<PageTitle>Google Cloud KMS — FlociLab</PageTitle>

<h1>Google Cloud KMS</h1>

<p class="lede">
    Create a key ring, create a crypto key inside it, encrypt, decrypt, then schedule the key
    version for destruction. This is <code>Google.Cloud.Kms.V1</code> used exactly as production
    would use it. Everything that differs sits in <code>KmsClientFactory</code>: the gRPC target
    and <code>ChannelCredentials.Insecure</code>, the same route <code>SecretManagerClientFactory</code>
    and <code>PubSubClientFactory</code> take.
</p>

<p class="lede">
    Cloud KMS has one more level of hierarchy than AWS KMS or Key Vault: a key ring holds crypto
    keys, and neither can ever be deleted — only a crypto key <em>version</em> can be scheduled for
    destruction. This page reuses one fixed key ring across every run, the way production code
    provisions it once, and creates a fresh crypto key per run — which stays listed forever, real
    Cloud KMS behaviour rather than a floci quirk.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci-gcp emulator" : "REAL Google Cloud — this costs money")
    </dd>
    <dt>gRPC target</dt>
    <dd><code>@this.Factory.GrpcTarget</code></dd>
    <dt>Project</dt>
    <dd><code>@this.Factory.ProjectId</code></dd>
    <dt>Location</dt>
    <dd><code>@this.Factory.LocationId</code></dd>
    <dt>Package</dt>
    <dd><code>Google.Cloud.Kms.V1</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci-gcp
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching Encrypt land before
            // its matching Decrypt read is most of the point of the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already scheduled the version's
            // destruction.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
