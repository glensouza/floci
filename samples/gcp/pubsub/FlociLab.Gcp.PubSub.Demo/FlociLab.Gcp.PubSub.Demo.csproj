<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Gcp.PubSub</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). Google.Cloud.PubSub.V1 is
    the same package a production app would reference, used exactly as production would use it —
    the only difference is the endpoint, which comes from FlociLab.Gcp.Endpoints'
    FlociGcpExtensions.ForFloci.

    Unlike Cloud Storage, Pub/Sub is gRPC end to end (plan §7), so this sample DOES reference
    FlociLab.Gcp.Endpoints for the insecure-channel wiring every non-Storage GCP sample needs.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="Google.Cloud.PubSub.V1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\FlociLab.Gcp.Endpoints\FlociLab.Gcp.Endpoints.csproj" />
  </ItemGroup>

</Project>
