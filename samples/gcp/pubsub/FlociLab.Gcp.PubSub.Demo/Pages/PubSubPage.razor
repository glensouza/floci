@page "/gcp/pubsub"
@inject PubSubDemo Demo
@inject PubSubClientFactory Factory
@implements IDisposable

<PageTitle>Google Cloud Pub/Sub — FlociLab</PageTitle>

<h1>Google Cloud Pub/Sub</h1>

<p class="lede">
    Create a topic, create a subscription on it, publish a message, pull it, acknowledge it,
    delete both. This is <code>Google.Cloud.PubSub.V1</code> used exactly as production would use
    it. Everything that differs sits in <code>PubSubClientFactory</code>: the gRPC target and
    <code>ChannelCredentials.Insecure</code>, which every non-Storage GCP sample needs — Pub/Sub is
    one Google service that genuinely is gRPC end to end.
</p>

<p class="lede">
    Pub/Sub has no single "queue" resource the way SQS or Azure's queues do: a topic accepts
    publishes and a subscription is what a reader pulls from, and a subscription only ever sees
    messages published <em>after</em> it existed. The round-trip below creates the subscription
    before publishing for exactly that reason — publishing first would leave the message
    undelivered, and the page would rather fail honestly than show a false green run.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci-gcp emulator" : "REAL Google Cloud — this costs money")
    </dd>
    <dt>gRPC target</dt>
    <dd><code>@this.Factory.GrpcTarget</code></dd>
    <dt>Project</dt>
    <dd><code>@this.Factory.ProjectId</code></dd>
    <dt>Package</dt>
    <dd><code>Google.Cloud.PubSub.V1</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci-gcp
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching CreateSubscription
            // land before Publish is most of the point of the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already cleaned the topic and
            // subscription up.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
