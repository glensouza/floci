@page "/gcp/secretmanager"
@inject SecretManagerDemo Demo
@inject SecretManagerClientFactory Factory
@implements IDisposable

<PageTitle>Google Cloud Secret Manager — FlociLab</PageTitle>

<h1>Google Cloud Secret Manager</h1>

<p class="lede">
    Create a secret, add a version, read it back, add a second version, read the update, delete it.
    This is <code>Google.Cloud.SecretManager.V1</code> used exactly as production would use it.
    Everything that differs sits in <code>SecretManagerClientFactory</code>: the gRPC target and
    <code>ChannelCredentials.Insecure</code>, the same route <code>PubSubClientFactory</code> and
    <code>FirestoreClientFactory</code> take.
</p>

<p class="lede">
    Secret Manager separates the container from its value: <code>CreateSecret</code> names the
    secret and its replication policy but carries no payload, and a value only exists once
    <code>AddSecretVersion</code> creates one. Reading a value always goes through the
    <code>"latest"</code> version alias rather than the secret name itself.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci-gcp emulator" : "REAL Google Cloud — this costs money")
    </dd>
    <dt>gRPC target</dt>
    <dd><code>@this.Factory.GrpcTarget</code></dd>
    <dt>Project</dt>
    <dd><code>@this.Factory.ProjectId</code></dd>
    <dt>Package</dt>
    <dd><code>Google.Cloud.SecretManager.V1</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci-gcp
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching the two AddSecretVersion
            // steps land before their matching AccessSecretVersion reads is most of the point of the
            // page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already cleaned the secret up.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
