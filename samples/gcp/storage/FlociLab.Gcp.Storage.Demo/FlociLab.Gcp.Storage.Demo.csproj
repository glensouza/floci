<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Gcp.Storage</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). Google.Cloud.Storage.V1 is
    the same package a production app would reference, used exactly as production would use it —
    the only difference is the endpoint, which comes from FlociLab.Core's GcpEndpoints.

    No FlociLab.Gcp.Endpoints reference, for the same reason the Azure Blob sample skips
    FlociLab.Azure.Endpoints. That project exists for the gRPC half of plan §7 and carries
    Google.Api.Gax.Grpc with it; Cloud Storage is the one Google service that is pure REST/JSON,
    and its dependency tree (Google.Api.Gax.Rest, Google.Apis.Storage.v1) contains no gRPC at all.
    Taking the reference would hand this sample a transport it never speaks. Every other GCP
    sample — Pub/Sub, Firestore, KMS — will need it.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="Google.Cloud.Storage.V1" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
  </ItemGroup>

</Project>
