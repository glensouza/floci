@page "/gcp/storage"
@inject StorageDemo Demo
@inject StorageClientFactory Factory
@implements IDisposable

<PageTitle>Google Cloud Storage — FlociLab</PageTitle>

<h1>Google Cloud Storage</h1>

<p class="lede">
    Create a bucket, upload an object, list it, read it back, delete both. This is
    <code>Google.Cloud.Storage.V1</code> used exactly as production would use it. Everything that
    differs sits in <code>StorageClientFactory</code>, and for once that is only two lines:
    <code>BaseUri</code> pointing at the emulator's JSON API, and
    <code>UnauthenticatedAccess</code> so the SDK stops hunting for credentials that do not exist.
</p>

<p class="lede">
    The plan called this the risky one. GCP is the hard provider — everything is multiplexed onto
    one port over HTTP/2, gRPC clients need insecure channels and pinned adapters — and the
    open question was whether this SDK would honour a custom <code>BaseUri</code> at all, or
    whether the sample would have to fall back to a hand-rolled <code>HttpClient</code> over the
    JSON API. It honours it. Cloud Storage turns out to be the one Google service that is pure
    REST/JSON, with no gRPC anywhere in its dependency tree, which makes it the easiest of the
    four object stores rather than the hardest.
</p>

<p class="lede">
    Two things below are genuinely unlike the S3 and Blob pages. The SDK returns <em>resources</em>
    rather than responses, so there is no status code to show — a call either hands back a
    populated <code>Bucket</code> or <code>Object</code> or it throws. And an upload is not one
    request: GCS defaults to a resumable upload, a POST that reserves a session followed by a PUT
    of the bytes, against <code>/upload/storage/v1/</code> rather than the JSON API's base.
</p>

<dl class="facts">
    <dt>Endpoint</dt>
    <dd><code>@this.Factory.BaseUri</code></dd>
    <dt>Uploads</dt>
    <dd><code>@this.Factory.UploadUri</code></dd>
    <dt>Project</dt>
    <dd><code>@this.Factory.ProjectId</code></dd>
    <dt>Package</dt>
    <dd><code>Google.Cloud.Storage.V1</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci-gcp
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching CreateBucket land
            // before UploadObject is most of the point of the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already cleaned the bucket up.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
