@page "/oci/objectstorage"
@inject ObjectStorageDemo Demo
@inject ObjectStorageClientFactory Factory
@implements IDisposable

<PageTitle>OCI Object Storage — FlociLab</PageTitle>

<h1>OCI Object Storage</h1>

<p class="lede">
    Look up the namespace, create a bucket, upload an object, list it, read it back, delete both.
    This is <code>OCI.DotNetSDK.Objectstorage</code> used exactly as production would use it.
    Everything that differs sits in <code>ObjectStorageClientFactory</code>: an authentication
    provider built from an RSA key generated at startup — the emulator parses signatures but never
    verifies them, so there is no key material anywhere in the repo — and the endpoint.
</p>

<p class="lede">
    Setting that endpoint is the sharpest edge in this repo, and it is worth stopping on.
    <code>client.SetEndpoint(...)</code> is <em>silently ignored</em>. The client is built with a
    realm-specific endpoint template derived from the region on the credential, every operation
    resolves its URI from that template, and <code>GetEndpoint()</code> goes on cheerfully
    reporting the emulator address you set. The call goes to real Oracle Cloud. Measured: a client
    pointed at <code>http://127.0.0.1:1</code> spent two seconds reaching Ashburn and came back
    with a genuine 401, while floci-oci's log stayed empty. The fix is one extra line —
    <code>SetRealmSpecificEndpointTemplate</code> — and it lives in
    <code>FlociLab.Oci.Endpoints</code> so no sample has to remember it.
</p>

<p class="lede">
    Two things below have no analog on the S3, Blob or GCS pages. Nothing can be addressed until
    you know the tenancy's Object Storage <em>namespace</em>, which is looked up rather than
    configured — hence the first step. And buckets live in a compartment rather than an account,
    so create and list both carry a compartment OCID. The tenancy OCID <em>is</em> the root
    compartment's, which is why one value serves both here.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci-oci emulator" : "REAL Oracle Cloud — this costs money")
    </dd>
    <dt>Endpoint</dt>
    <dd>
        @if (this.Factory.Endpoint is not null)
        {
            <code>@this.Factory.Endpoint</code>
        }
        else
        {
            @* Real-cloud mode overrides nothing, so there is no endpoint to show — the SDK builds
               one from the region. Printing the emulator address here would be the same quiet lie
               the ledes above are about. *@
            <span>resolved by the SDK from the region</span>
        }
    </dd>
    <dt>Region</dt>
    <dd><code>@this.Factory.Region</code></dd>
    <dt>Compartment</dt>
    <dd><code>@this.Factory.CompartmentId</code></dd>
    <dt>Package</dt>
    <dd><code>OCI.DotNetSDK.Objectstorage</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci-oci
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching GetNamespace land
            // before anything can be addressed is most of the point of the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already cleaned the bucket up.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
