<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>FlociLab.Oci.Queue</RootNamespace>
  </PropertyGroup>

  <!--
    ONE official cloud package (docs/BLAZOR-PLAN.md §3, constraint 1). OCI.DotNetSDK.Queue is the
    same package a production app would reference, used exactly as production would use it — the
    only difference is the endpoint and the auth provider, both of which come from
    FlociLab.Oci.Endpoints. That project carries OCI.DotNetSDK.Common, which this package already
    depends on, so the reference costs this sample nothing.

    FrameworkReference rather than a Microsoft.AspNetCore.Components.Web package reference: this
    RCL only ever renders server-side inside an ASP.NET Core host, so the shared framework already
    has the components, and there is no extra version to pin.
  -->
  <ItemGroup>
    <PackageReference Include="OCI.DotNetSDK.Queue" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\..\..\src\FlociLab.Oci.Endpoints\FlociLab.Oci.Endpoints.csproj" />
  </ItemGroup>

</Project>
