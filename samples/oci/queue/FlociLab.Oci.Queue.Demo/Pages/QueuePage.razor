@page "/oci/queue"
@inject QueueDemo Demo
@inject QueueClientFactory Factory
@implements IDisposable

<PageTitle>OCI Queue — FlociLab</PageTitle>

<h1>OCI Queue</h1>

<p class="lede">
    Create a queue, send a message, receive it, delete it, delete the queue. This is
    <code>OCI.DotNetSDK.Queue</code> used exactly as production would use it — split, the way the
    real service is split, across two clients: <code>QueueAdminClient</code> for the queue itself
    and <code>QueueClient</code> for its messages.
</p>

<p class="lede">
    <code>CreateQueue</code> and <code>DeleteQueue</code> are asynchronous even here: both answer
    <code>202 Accepted</code> with an <code>opc-work-request-id</code>, exactly like real OCI, and
    this page polls that work request to completion with <code>QueueAdminClient.Waiters</code>
    rather than trusting the 202 — the same wait production code needs.
</p>

<p class="lede">
    The sharpest edge on this page: real OCI Queue is <em>host-routed</em> — every queue answers
    for its own messages at a <code>messagesEndpoint</code> that <code>GetQueue</code> hands back,
    a different host from the one that created it, the same shape Cloud Run and GKE use. floci-oci
    builds that value from its own <code>FLOCI_OCI_HOSTNAME</code> setting rather than from the
    request, and the lab leaves that unset — so every queue here reports the literal
    <code>http://localhost:4599</code>, whatever address you actually reached it on. That happens
    to work from this host on the default port and reaches nothing at all from a sibling container
    or from a test on a random port, so it is right only by coincidence.
    <code>QueueClientFactory.CreateData</code> builds the data-plane client against that reported
    address the way production code would, then repoints it at the configured endpoint with the
    same <code>ForFloci</code> the object storage page uses for <code>SetEndpoint</code>.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci-oci emulator" : "REAL Oracle Cloud — this costs money")
    </dd>
    <dt>Endpoint</dt>
    <dd>
        @if (this.Factory.Endpoint is not null)
        {
            <code>@this.Factory.Endpoint</code>
        }
        else
        {
            @* Real-cloud mode overrides nothing for the admin client, and the data client is
               built per-queue from GetQueue's own answer — there is no fixed endpoint to show. *@
            <span>resolved by the SDK from the region, and per-queue from GetQueue</span>
        }
    </dd>
    <dt>Region</dt>
    <dd><code>@this.Factory.Region</code></dd>
    <dt>Compartment</dt>
    <dd><code>@this.Factory.CompartmentId</code></dd>
    <dt>Package</dt>
    <dd><code>OCI.DotNetSDK.Queue</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci-oci
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching CreateQueue's work
            // request settle before anything can be addressed is most of the point of the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already cleaned the queue up.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
