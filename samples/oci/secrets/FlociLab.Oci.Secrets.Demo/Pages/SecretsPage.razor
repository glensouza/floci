@page "/oci/secrets"
@inject SecretsDemo Demo
@inject SecretsClientFactory Factory
@implements IDisposable

<PageTitle>OCI Secrets — FlociLab</PageTitle>

<h1>OCI Secrets</h1>

<p class="lede">
    Create a secret in a configured vault, read the value back, update it, read the update, then
    schedule the secret for deletion. This is ordinary code against two official SDK packages — the
    only emulator-aware lines are in <code>SecretsClientFactory</code>.
</p>

<p class="lede">
    Real OCI splits this service across two planes that ship separately: secret CRUD goes through
    <code>OCI.DotNetSDK.Vault</code>'s <code>VaultsClient</code>, and reading the decrypted value
    back is a genuinely separate data-plane client, <code>OCI.DotNetSDK.Secrets</code>'s
    <code>SecretsClient</code> — real OCI's own control-plane/data-plane split, not a workaround.
</p>

<p class="lede">
    <code>CreateSecret</code> hard-requires a <code>vaultId</code> and a <code>keyId</code>.
    Provisioning those needs a third package, <code>OCI.DotNetSDK.Keymanagement</code>, which this
    sample deliberately does not carry — so both arrive as configuration, which is how production
    reaches them anyway: a vault and a master encryption key are long-lived infrastructure that
    Terraform provisions once. The <a href="/oci/vault">OCI Vault</a> page is the one that creates
    them.
</p>

<p class="lede">
    Unlike the vault and key it depends on, <code>CreateSecret</code> answers <code>ACTIVE</code>
    directly on floci-oci — there is no <code>CREATING</code> state to poll for the secret itself.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci-oci emulator" : "REAL Oracle Cloud — this costs money")
    </dd>
    <dt>Endpoint</dt>
    <dd>
        @if (this.Factory.Endpoint is not null)
        {
            <code>@this.Factory.Endpoint</code>
        }
        else
        {
            <span>resolved by the SDK from the region</span>
        }
    </dd>
    <dt>Region</dt>
    <dd><code>@this.Factory.Region</code></dd>
    <dt>Compartment</dt>
    <dd><code>@this.Factory.CompartmentId</code></dd>
    <dt>Vault</dt>
    <dd>
        @if (this.Factory.VaultId is not null)
        {
            <code>@this.Factory.VaultId</code>
        }
        else
        {
            <span class="unset">unset — set <code>Floci:Oci:VaultId</code></span>
        }
    </dd>
    <dt>Key</dt>
    <dd>
        @if (this.Factory.KeyId is not null)
        {
            <code>@this.Factory.KeyId</code>
        }
        else
        {
            <span class="unset">unset — set <code>Floci:Oci:KeyId</code></span>
        }
    </dd>
    <dt>Packages</dt>
    <dd><code>OCI.DotNetSDK.Vault</code>, <code>OCI.DotNetSDK.Secrets</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci-oci
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching the two
            // GetSecretBundle steps land before and after UpdateSecret is most of the point of
            // the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already scheduled cleanup.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
