@page "/oci/vault"
@inject VaultDemo Demo
@inject VaultClientFactory Factory
@implements IDisposable

<PageTitle>OCI Vault — FlociLab</PageTitle>

<h1>OCI Vault</h1>

<p class="lede">
    Create a vault, create a software-protected AES-256 key inside it, encrypt, decrypt, then
    schedule the key and the vault for deletion. This is <code>OCI.DotNetSDK.Keymanagement</code>
    used exactly as production would use it — split, the way the real service is split, across
    three clients: <code>KmsVaultClient</code> for the vault itself, <code>KmsManagementClient</code>
    for keys, and <code>KmsCryptoClient</code> for encrypt/decrypt.
</p>

<p class="lede">
    <code>CreateVault</code> answers before the vault is <code>ACTIVE</code> on real OCI, so this
    page polls that state with <code>KmsVaultClient.Waiters</code> rather than trusting the create
    response — the same wait <code>OCI Queue</code>'s work requests need.
</p>

<p class="lede">
    The sharpest edge on this page: real OCI Vault is <em>host-routed</em>, the same shape as OCI
    Queue — every vault answers for its own keys at a <code>managementEndpoint</code> and
    <code>cryptoEndpoint</code> that <code>CreateVault</code> hands back, a different host from the
    one that created it. floci-oci builds those values from its own configuration rather than from
    the request, so <code>VaultClientFactory.CreateManagement</code> and
    <code>.CreateCrypto</code> build each client against the reported address the way production
    code would, then repoint it at the configured endpoint with <code>ForFloci</code>.
</p>

<dl class="facts">
    <dt>Target</dt>
    <dd class="target @(this.Factory.UseEmulator ? "target-emulator" : "target-real")">
        @(this.Factory.UseEmulator ? "floci-oci emulator" : "REAL Oracle Cloud — this costs money")
    </dd>
    <dt>Endpoint</dt>
    <dd>
        @if (this.Factory.Endpoint is not null)
        {
            <code>@this.Factory.Endpoint</code>
        }
        else
        {
            @* Real-cloud mode overrides nothing for the vault client, and the management/crypto
               clients are built per-vault from CreateVault's own answer — there is no fixed
               endpoint to show. *@
            <span>resolved by the SDK from the region, and per-vault from CreateVault</span>
        }
    </dd>
    <dt>Region</dt>
    <dd><code>@this.Factory.Region</code></dd>
    <dt>Compartment</dt>
    <dd><code>@this.Factory.CompartmentId</code></dd>
    <dt>Package</dt>
    <dd><code>OCI.DotNetSDK.Keymanagement</code></dd>
</dl>

<div class="toolbar">
    <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
        @(this.running ? "Running…" : "Run the round-trip")
    </button>
    @if (!this.RendererInfo.IsInteractive)
    {
        <span class="note">Waiting for the interactive circuit…</span>
    }
    else if (this.finishedAt is not null)
    {
        <span class="note">
            @this.steps.Count step(s), @(this.steps.Count(s => !s.Succeeded)) failed —
            @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")
        </span>
    }
</div>

@if (this.steps.Count == 0 && !this.running)
{
    <p class="empty">
        Nothing has run yet. Every step below will show the wire-level request and what floci-oci
        actually answered, including the failures.
    </p>
}

@foreach (DemoStep step in this.steps)
{
    <section class="step @(step.Succeeded ? "step-ok" : "step-failed")">
        <h2>
            @step.Title
            <span class="badge @(step.Succeeded ? "badge-ok" : "badge-error")">
                @(step.Succeeded ? "Ok" : "Failed")
            </span>
        </h2>

        @if (step.Request is not null)
        {
            <h3>Request</h3>
            <pre>@step.Request</pre>
        }

        @if (step.Response is not null)
        {
            <h3>Response</h3>
            <pre>@step.Response</pre>
        }

        @if (step.Error is not null)
        {
            <h3>Error</h3>
            <pre class="error">@step.Error</pre>
        }
    </section>
}

@code {
    private readonly List<DemoStep> steps = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.steps.Clear();
        this.StateHasChanged();

        try
        {
            // Rendered as they arrive rather than collected first: watching CreateVault's wait for
            // ACTIVE land before a key can be addressed is most of the point of the page.
            await foreach (DemoStep step in this.Demo.RunAsync(this.cts.Token))
            {
                this.steps.Add(step);
                this.StateHasChanged();
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run. The demo's own finally has already scheduled cleanup.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunAsync may still be inside an SDK call registered on this
        // token, and disposing underneath it throws ObjectDisposedException instead of cancelling.
        this.cts.Cancel();
    }
}
