@page "/compare/document-db"
@inject IEnumerable<IDocumentDbCapability> Stores
@implements IDisposable

<PageTitle>Document DB — compare</PageTitle>

<h1>Document DB</h1>

<p class="lede">
    The same five operations — create a collection, list collections, upsert a document, read it
    back, delete the collection — run against every registered provider at once, each through its
    own official SDK. This page knows only <code>IDocumentDbCapability</code>; it never references
    a cloud SDK. No OCI analog, by design.
</p>

@{
    IReadOnlyList<IDocumentDbCapability> stores = [.. this.Stores.OrderBy(s => CloudProvider.Order(s.Provider))];
}

@if (stores.Count == 0)
{
    <p class="empty">
        No document-DB sample is registered. Each sample RCL brings its own
        <code>IDocumentDbCapability</code> with it — see docs/BLAZOR-PLAN.md §8.
    </p>
}
else
{
    <div class="toolbar">
        <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
            @(this.running ? "Running…" : "Run on all providers")
        </button>
        @if (!this.RendererInfo.IsInteractive)
        {
            <span class="note">Waiting for the interactive circuit…</span>
        }
        else if (this.finishedAt is not null)
        {
            <span class="note">Finished @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
        }
    </div>

    @if (this.results.Count == 0 && !this.running)
    {
        <p class="empty">
            Nothing has run yet. Each column below is one provider's own SDK doing the same
            round-trip — a collection the run creates and, if it got that far, deletes again.
        </p>
    }
    else
    {
        <table class="grid compare">
            <thead>
                <tr>
                    <th>Operation</th>
                    @foreach (IDocumentDbCapability store in stores)
                    {
                        <th>
                            @CloudProvider.DisplayName(store.Provider)
                            <span class="note">@store.ServiceName</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Operations.Length; i++)
                {
                    int operationIndex = i;
                    <tr>
                        <td>@Operations[operationIndex]</td>
                        @foreach (IDocumentDbCapability store in stores)
                        {
                            ComparisonCell? cell = this.results.TryGetValue(store, out ComparisonCell[]? row)
                                ? row[operationIndex]
                                : null;
                            <td>
                                @if (cell is null)
                                {
                                    <span class="note">—</span>
                                }
                                else
                                {
                                    <span class="badge @BadgeClass(cell.Status)">@StatusLabel(cell.Status)</span>
                                    @if (cell.Status != CellStatus.Skipped)
                                    {
                                        <div class="numeric note">@cell.Elapsed.TotalMilliseconds.ToString("0") ms</div>
                                    }
                                    <div class="detail">@cell.Detail</div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private static readonly string[] Operations = ["Create collection", "List collections", "Upsert document", "Get document", "Delete collection"];

    // Keyed on the capability instance rather than on Provider, same reasoning as
    // ObjectStoragePage, QueuesPage and SecretsPage: a provider slug is not guaranteed to be
    // one-to-one with a registered capability, and keying on it would let a second registration
    // silently overwrite the first in this dictionary.
    private readonly Dictionary<IDocumentDbCapability, ComparisonCell[]> results = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.results.Clear();
        this.StateHasChanged();

        try
        {
            IReadOnlyList<IDocumentDbCapability> stores = [.. this.Stores.OrderBy(s => CloudProvider.Order(s.Provider))];

            // No ConfigureAwait(false) here, unlike the helpers below: this await has to resume
            // back on the circuit's Dispatcher, because the finally block below calls
            // StateHasChanged(), which throws off a thread pool continuation.
            ComparisonCell[][] rows = await Task.WhenAll(stores.Select(store => RunOneAsync(store, this.cts.Token)));

            for (int i = 0; i < stores.Count; i++)
            {
                this.results[stores[i]] = rows[i];
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    /// <summary>
    /// One provider's column, index-aligned with <see cref="Operations"/>. Upsert and get are
    /// skipped rather than attempted when the collection never got created. That is a deliberate
    /// choice to keep the columns comparable, <em>not</em> a provider constraint: DynamoDB and
    /// Cosmos do require the table/container to exist first, but Firestore creates a collection
    /// implicitly on the first document write, so its upsert and get would have succeeded on their
    /// own. Attempting them anyway would make the GCP column tell a different story from the other
    /// two about the same failed run. Delete runs from a finally whether or not the create reported success,
    /// cleaning up regardless of what happened in between — including a cancelled run — so a run
    /// never leaks a collection into the account. Same shape as ObjectStoragePage's bucket
    /// lifecycle.
    /// </summary>
    private static async Task<ComparisonCell[]> RunOneAsync(IDocumentDbCapability store, CancellationToken ct)
    {
        string collection = $"flocilab-cmp-{store.Provider}-{Guid.NewGuid():N}";
        string id = Guid.NewGuid().ToString("N");
        string message = $"FlociLab comparison — {store.ServiceName} — {DateTimeOffset.UtcNow:O}";

        // Serialized rather than interpolated into a JSON literal. ServiceName belongs to the
        // capability, not to this page, and a quote or backslash in some future provider's name
        // would emit malformed JSON that every capability's upsert rejects on the way in
        // (Document.FromJson, JsonDocument.Parse) — surfacing as a red "Upsert document" cell
        // blaming the emulator for a bug on this side of the wire. ObjectStoragePage interpolates
        // the same value safely because its payload is opaque bytes; this page has a parser in the
        // path.
        string json = JsonSerializer.Serialize(new Dictionary<string, string> { ["id"] = id, ["message"] = message });

        ComparisonCell[] cells = new ComparisonCell[Operations.Length];
        bool collectionReady = false;

        try
        {
            cells[0] = await TimeAsync(store, async () =>
            {
                await store.CreateCollectionAsync(collection, ct).ConfigureAwait(false);
                collectionReady = true;
                return $"Created {collection}";
            }).ConfigureAwait(false);

            cells[1] = await TimeAsync(store, async () =>
            {
                IReadOnlyList<CollectionInfo> collections = await store.ListCollectionsAsync(ct).ConfigureAwait(false);

                // Once the create is green the collection provably exists, so a listing that does
                // not contain it has not achieved what an "Ok" badge claims — returning the count
                // as a string would paint a green "0 collection(s)" over exactly the routing or
                // project/compartment-filter mismatch this page exists to expose (§14). Only
                // asserted when collectionReady: before that, listing whatever else is in the
                // account is a legitimate result.
                if (collectionReady && !collections.Any(c => c.Name == collection))
                {
                    throw new InvalidOperationException($"listed {collections.Count} collection(s), none of them {collection}");
                }

                return $"{collections.Count} collection(s)";
            }).ConfigureAwait(false);

            if (!collectionReady)
            {
                // Says which of the two it was, because they mean opposite things to a reader: an
                // unimplemented CreateCollection is a documented gap in the emulator, a failed one
                // is a problem with the run.
                string reason = cells[0].Status == CellStatus.NotImplemented
                    ? "CreateCollection is not implemented"
                    : "collection create failed";

                cells[2] = Skipped(reason);
                cells[3] = Skipped(reason);

                return cells;
            }

            cells[2] = await TimeAsync(store, async () =>
            {
                await store.UpsertDocumentAsync(collection, id, json, ct).ConfigureAwait(false);
                return $"Upserted {id}";
            }).ConfigureAwait(false);

            cells[3] = await TimeAsync(store, async () =>
            {
                string? returned = await store.GetDocumentAsync(collection, id, ct).ConfigureAwait(false);

                // The id is generated fresh per run, so a null here means the write did not stick,
                // not that some other document was found.
                if (returned is null)
                {
                    throw new InvalidOperationException("document did not round-trip");
                }

                // "Round-trip matched" is a claim about the *payload*, so the payload is what gets
                // compared — the document-DB analogue of ObjectStoragePage's SequenceEqual.
                // Existence alone is not that claim: all three capabilities overwrite the id and
                // leave the remaining fields to the SDK, so a write that persisted the key and
                // dropped the body still comes back non-null and would render green over a
                // document that lost everything the run put in it (§14).
                //
                // Compared field by field rather than as a string, because the JSON text differs on
                // two of the three columns even when the round-trip is perfect: Cosmos returns
                // _rid/_etag/_ts alongside the document, and Firestore reserializes from a
                // dictionary rather than echoing what was sent.
                string? echoed = ReadMessage(returned);

                return echoed == message
                    ? "Round-trip matched"
                    : throw new InvalidOperationException($"document came back with message '{echoed ?? "<absent>"}'");
            }).ConfigureAwait(false);
        }
        finally
        {
            // In a finally, and on CancellationToken.None rather than ct, because this is the only
            // thing standing between an abandoned run and an orphan collection. TimeAsync
            // deliberately lets OperationCanceledException escape, and Dispose() cancels ct the
            // moment the user navigates away mid-run — so without the finally the delete is
            // skipped entirely, and with the finally but on ct it would be handed an
            // already-cancelled token and do nothing. Every abandoned run would leave
            // flocilab-cmp-* behind on all three providers.
            //
            // One leak this does not close, recorded rather than worked around: against real AWS
            // (UseEmulator=false), DynamoDbDocumentDb.CreateCollectionAsync polls DescribeTable for
            // up to 30 s on ct, so a viewer navigating away mid-create cancels the poll and the
            // DeleteTable below arrives while the table is still CREATING — which real AWS rejects
            // with ResourceInUseException, leaving the table. Retrying here would block a disposed
            // component's cleanup for another 30 s, which is worse than the red cell; the honest
            // read is the failed delete (§14).
            //
            // Unconditional — deliberately not gated on collectionReady, same reasoning as
            // ObjectStoragePage and SecretsPage: a create whose request landed and whose response
            // did not leaves a real collection behind, and gating cleanup on success is exactly
            // how that leak stays invisible. The cost is a red cell on a provider that never
            // created anything, which is the honest read anyway — a cleanup step is a step, and
            // one that removed nothing has not achieved what its badge claims (§14).
            cells[4] = await TimeAsync(store, async () =>
            {
                await store.DeleteCollectionAsync(collection, CancellationToken.None).ConfigureAwait(false);
                return "Deleted";
            }).ConfigureAwait(false);
        }

        return cells;
    }

    /// <summary>
    /// Times one operation and, on failure, asks the capability to classify its own SDK's
    /// exception. This page references no cloud SDK, so it cannot tell a documented 501 from a
    /// socket error on its own — and painting a documented 501 the same red as a genuine break is
    /// exactly what constraint 6 forbids.
    /// </summary>
    private static async Task<ComparisonCell> TimeAsync(IDocumentDbCapability store, Func<Task<string>> operation)
    {
        Stopwatch stopwatch = Stopwatch.StartNew();

        try
        {
            string detail = await operation().ConfigureAwait(false);

            return new ComparisonCell(CellStatus.Ok, stopwatch.Elapsed, detail);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return new ComparisonCell(FromProbe(store.Classify(ex)), stopwatch.Elapsed, ex.Message);
        }
    }

    private static CellStatus FromProbe(ProbeStatus status) => status switch
    {
        ProbeStatus.Ok => CellStatus.Ok,
        ProbeStatus.NotImplemented => CellStatus.NotImplemented,
        ProbeStatus.Unreachable => CellStatus.Unreachable,
        _ => CellStatus.Failed,
    };

    /// <summary>
    /// The "message" property of a returned document, or null when it is absent or not a string.
    /// Every column's <c>GetDocumentAsync</c> hands back a JSON object, but each builds it its own
    /// way — DynamoDB from an attribute map, Cosmos straight off the response stream, Firestore
    /// from a dictionary — so the one thing worth comparing is the field the run actually wrote.
    /// </summary>
    private static string? ReadMessage(string json)
    {
        using JsonDocument parsed = JsonDocument.Parse(json);

        return parsed.RootElement.TryGetProperty("message", out JsonElement message) && message.ValueKind == JsonValueKind.String
            ? message.GetString()
            : null;
    }

    private static ComparisonCell Skipped(string reason) => new(CellStatus.Skipped, TimeSpan.Zero, reason);

    // Deliberately the same class names /coverage uses, so a 501 looks identical on both pages.
    private static string BadgeClass(CellStatus status) => status switch
    {
        CellStatus.Ok => "badge-ok",
        CellStatus.NotImplemented => "badge-notimplemented",
        CellStatus.Unreachable or CellStatus.Skipped => "badge-unreachable",
        _ => "badge-error",
    };

    private static string StatusLabel(CellStatus status) => status switch
    {
        CellStatus.Ok => "Ok",
        CellStatus.NotImplemented => "Not implemented",
        CellStatus.Unreachable => "Unreachable",
        CellStatus.Skipped => "Skipped",
        _ => "Failed",
    };

    /// <summary>The four <see cref="ProbeStatus"/> outcomes, plus the one a probe has no notion
    /// of: an operation this page chose not to attempt.</summary>
    private enum CellStatus
    {
        Ok,
        NotImplemented,
        Unreachable,
        Failed,
        Skipped,
    }

    private sealed record ComparisonCell(CellStatus Status, TimeSpan Elapsed, string Detail);

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunOneAsync may still be inside an SDK call registered on
        // this token, and disposing underneath it throws ObjectDisposedException instead of
        // cancelling.
        this.cts.Cancel();
    }
}
