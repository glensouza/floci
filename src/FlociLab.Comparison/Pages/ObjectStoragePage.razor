@page "/compare/object-storage"
@inject IEnumerable<IObjectStoreCapability> Stores
@implements IDisposable

<PageTitle>Object storage — compare</PageTitle>

<h1>Object storage</h1>

<p class="lede">
    The same five operations — create a bucket, list buckets, put an object, read it back, delete
    the bucket — run against every registered provider at once, each through its own official SDK.
    This page knows only <code>IObjectStoreCapability</code>; it never references a cloud SDK.
</p>

@{
    IReadOnlyList<IObjectStoreCapability> stores = [.. this.Stores.OrderBy(s => CloudProvider.Order(s.Provider))];
}

@if (stores.Count == 0)
{
    <p class="empty">
        No object-storage sample is registered. Each sample RCL brings its own
        <code>IObjectStoreCapability</code> with it — see docs/BLAZOR-PLAN.md §8.
    </p>
}
else
{
    <div class="toolbar">
        <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
            @(this.running ? "Running…" : "Run on all providers")
        </button>
        @if (!this.RendererInfo.IsInteractive)
        {
            <span class="note">Waiting for the interactive circuit…</span>
        }
        else if (this.finishedAt is not null)
        {
            <span class="note">Finished @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
        }
    </div>

    @if (this.results.Count == 0 && !this.running)
    {
        <p class="empty">
            Nothing has run yet. Each column below is one provider's own SDK doing the same
            round-trip — a bucket the run creates and, if it got that far, deletes again.
        </p>
    }
    else
    {
        <table class="grid compare">
            <thead>
                <tr>
                    <th>Operation</th>
                    @foreach (IObjectStoreCapability store in stores)
                    {
                        <th>
                            @CloudProvider.DisplayName(store.Provider)
                            <span class="note">@store.ServiceName</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Operations.Length; i++)
                {
                    int operationIndex = i;
                    <tr>
                        <td>@Operations[operationIndex]</td>
                        @foreach (IObjectStoreCapability store in stores)
                        {
                            ComparisonCell? cell = this.results.TryGetValue(store, out ComparisonCell[]? row)
                                ? row[operationIndex]
                                : null;
                            <td>
                                @if (cell is null)
                                {
                                    <span class="note">—</span>
                                }
                                else
                                {
                                    <span class="badge @BadgeClass(cell.Status)">@StatusLabel(cell.Status)</span>
                                    @if (cell.Status != CellStatus.Skipped)
                                    {
                                        <div class="numeric note">@cell.Elapsed.TotalMilliseconds.ToString("0") ms</div>
                                    }
                                    <div class="detail">@cell.Detail</div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private static readonly string[] Operations = ["Create bucket", "List buckets", "Put object", "Get object", "Delete bucket"];

    // Keyed on the capability instance rather than on Provider: the table renders one column per
    // registered IObjectStoreCapability, and the plan's §8 table already anticipates two services
    // sharing one provider slug (Azure's "Queue Storage + Service Bus"). Keying on the slug would
    // let the second registration overwrite the first and then render one SDK's results under both
    // headers, silently and with no error. The injected IEnumerable resolves to one array, so the
    // same references are enumerated here and in the render body.
    private readonly Dictionary<IObjectStoreCapability, ComparisonCell[]> results = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.results.Clear();
        this.StateHasChanged();

        try
        {
            IReadOnlyList<IObjectStoreCapability> stores = [.. this.Stores.OrderBy(s => CloudProvider.Order(s.Provider))];

            // No ConfigureAwait(false) here, unlike the helpers below: this await has to resume
            // back on the circuit's Dispatcher, because the finally block below calls
            // StateHasChanged(), which throws off a thread pool continuation.
            ComparisonCell[][] rows = await Task.WhenAll(stores.Select(store => RunOneAsync(store, this.cts.Token)));

            for (int i = 0; i < stores.Count; i++)
            {
                this.results[stores[i]] = rows[i];
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    /// <summary>
    /// One provider's column, index-aligned with <see cref="Operations"/>. Put and get are
    /// skipped rather than attempted when the bucket never got created — every provider here
    /// requires an existing bucket for both, so running them anyway would just report the same
    /// failure twice. Delete runs from a finally once a bucket exists, cleaning up regardless of
    /// what happened to the object in between — including a cancelled run — so a run never leaks a
    /// bucket into the account.
    /// </summary>
    private static async Task<ComparisonCell[]> RunOneAsync(IObjectStoreCapability store, CancellationToken ct)
    {
        string bucket = $"flocilab-cmp-{store.Provider}-{Guid.NewGuid():N}";
        const string Key = "hello.txt";
        byte[] payload = Encoding.UTF8.GetBytes($"FlociLab comparison — {store.ServiceName} — {DateTimeOffset.UtcNow:O}");

        ComparisonCell[] cells = new ComparisonCell[Operations.Length];
        bool bucketReady = false;

        cells[0] = await TimeAsync(store, async () =>
        {
            await store.CreateContainerAsync(bucket, ct).ConfigureAwait(false);
            bucketReady = true;
            return $"Created {bucket}";
        }).ConfigureAwait(false);

        cells[1] = await TimeAsync(store, async () =>
        {
            IReadOnlyList<ContainerInfo> containers = await store.ListContainersAsync(ct).ConfigureAwait(false);
            return $"{containers.Count} container(s)";
        }).ConfigureAwait(false);

        if (!bucketReady)
        {
            // Says which of the two it was, because they mean opposite things to a reader: an
            // unimplemented CreateBucket is a documented gap in the emulator, a failed one is a
            // problem with the run.
            string reason = cells[0].Status == CellStatus.NotImplemented
                ? "CreateBucket is not implemented"
                : "bucket create failed";

            cells[2] = Skipped(reason);
            cells[3] = Skipped(reason);
            cells[4] = Skipped(reason);

            return cells;
        }

        try
        {
            cells[2] = await TimeAsync(store, async () =>
            {
                using MemoryStream stream = new(payload);
                await store.PutObjectAsync(bucket, Key, stream, ct).ConfigureAwait(false);
                return $"{payload.Length} byte(s) as {Key}";
            }).ConfigureAwait(false);

            cells[3] = await TimeAsync(store, async () =>
            {
                await using Stream returned = await store.GetObjectAsync(bucket, Key, ct).ConfigureAwait(false);
                using MemoryStream buffer = new();
                await returned.CopyToAsync(buffer, ct).ConfigureAwait(false);

                return buffer.ToArray().AsSpan().SequenceEqual(payload)
                    ? $"{buffer.Length} byte(s), round-trip matched"
                    : throw new InvalidOperationException("content did not round-trip");
            }).ConfigureAwait(false);
        }
        finally
        {
            // In a finally, and on CancellationToken.None rather than ct, because this is the only
            // thing standing between an abandoned run and an orphan bucket. TimeAsync deliberately
            // lets OperationCanceledException escape, and Dispose() cancels ct the moment the user
            // navigates away mid-run — so without the finally the delete is skipped entirely, and
            // with the finally but on ct it would be handed an already-cancelled token and do
            // nothing. Every abandoned run would leave flocilab-cmp-* behind on all four providers.
            // Same reasoning, and the same choice, as S3Demo's cleanup step.
            cells[4] = await TimeAsync(store, async () =>
            {
                await store.DeleteContainerAsync(bucket, CancellationToken.None).ConfigureAwait(false);
                return "Deleted";
            }).ConfigureAwait(false);
        }

        return cells;
    }

    /// <summary>
    /// Times one operation and, on failure, asks the capability to classify its own SDK's
    /// exception. This page references no cloud SDK, so it cannot tell an AmazonServiceException
    /// carrying a 501 from a socket error on its own — and painting a documented 501 the same red
    /// as a genuine break is exactly what constraint 6 forbids.
    /// </summary>
    private static async Task<ComparisonCell> TimeAsync(IObjectStoreCapability store, Func<Task<string>> operation)
    {
        Stopwatch stopwatch = Stopwatch.StartNew();

        try
        {
            string detail = await operation().ConfigureAwait(false);

            return new ComparisonCell(CellStatus.Ok, stopwatch.Elapsed, detail);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return new ComparisonCell(FromProbe(store.Classify(ex)), stopwatch.Elapsed, ex.Message);
        }
    }

    private static CellStatus FromProbe(ProbeStatus status) => status switch
    {
        ProbeStatus.Ok => CellStatus.Ok,
        ProbeStatus.NotImplemented => CellStatus.NotImplemented,
        ProbeStatus.Unreachable => CellStatus.Unreachable,
        _ => CellStatus.Failed,
    };

    private static ComparisonCell Skipped(string reason) => new(CellStatus.Skipped, TimeSpan.Zero, reason);

    // Deliberately the same class names /coverage uses, so a 501 looks identical on both pages.
    private static string BadgeClass(CellStatus status) => status switch
    {
        CellStatus.Ok => "badge-ok",
        CellStatus.NotImplemented => "badge-notimplemented",
        CellStatus.Unreachable or CellStatus.Skipped => "badge-unreachable",
        _ => "badge-error",
    };

    private static string StatusLabel(CellStatus status) => status switch
    {
        CellStatus.Ok => "Ok",
        CellStatus.NotImplemented => "Not implemented",
        CellStatus.Unreachable => "Unreachable",
        CellStatus.Skipped => "Skipped",
        _ => "Failed",
    };

    /// <summary>The four <see cref="ProbeStatus"/> outcomes, plus the one a probe has no notion
    /// of: an operation this page chose not to attempt.</summary>
    private enum CellStatus
    {
        Ok,
        NotImplemented,
        Unreachable,
        Failed,
        Skipped,
    }

    private sealed record ComparisonCell(CellStatus Status, TimeSpan Elapsed, string Detail);

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunOneAsync may still be inside an SDK call registered on
        // this token, and disposing underneath it throws ObjectDisposedException instead of
        // cancelling.
        this.cts.Cancel();
    }
}
