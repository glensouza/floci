@page "/compare/queues"
@inject IEnumerable<IQueueCapability> Queues
@implements IDisposable

<PageTitle>Queues — compare</PageTitle>

<h1>Queues</h1>

<p class="lede">
    The same five operations — create a queue, list queues, send a message, receive it back, delete
    the queue — run against every registered provider at once, each through its own official SDK.
    This page knows only <code>IQueueCapability</code>; it never references a cloud SDK.
</p>

@{
    IReadOnlyList<IQueueCapability> queues = [.. this.Queues.OrderBy(q => CloudProvider.Order(q.Provider))];
}

@if (queues.Count == 0)
{
    <p class="empty">
        No queue sample is registered. Each sample RCL brings its own <code>IQueueCapability</code>
        with it — see docs/BLAZOR-PLAN.md §8.
    </p>
}
else
{
    <div class="toolbar">
        <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
            @(this.running ? "Running…" : "Run on all providers")
        </button>
        @if (!this.RendererInfo.IsInteractive)
        {
            <span class="note">Waiting for the interactive circuit…</span>
        }
        else if (this.finishedAt is not null)
        {
            <span class="note">Finished @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
        }
    </div>

    @if (this.results.Count == 0 && !this.running)
    {
        <p class="empty">
            Nothing has run yet. Each column below is one provider's own SDK doing the same
            round-trip — a queue the run creates and, if it got that far, deletes again.
        </p>
    }
    else
    {
        <table class="grid compare">
            <thead>
                <tr>
                    <th>Operation</th>
                    @foreach (IQueueCapability queue in queues)
                    {
                        <th>
                            @CloudProvider.DisplayName(queue.Provider)
                            <span class="note">@queue.ServiceName</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Operations.Length; i++)
                {
                    int operationIndex = i;
                    <tr>
                        <td>@Operations[operationIndex]</td>
                        @foreach (IQueueCapability queue in queues)
                        {
                            ComparisonCell? cell = this.results.TryGetValue(queue, out ComparisonCell[]? row)
                                ? row[operationIndex]
                                : null;
                            <td>
                                @if (cell is null)
                                {
                                    <span class="note">—</span>
                                }
                                else
                                {
                                    <span class="badge @BadgeClass(cell.Status)">@StatusLabel(cell.Status)</span>
                                    @if (cell.Status != CellStatus.Skipped)
                                    {
                                        <div class="numeric note">@cell.Elapsed.TotalMilliseconds.ToString("0") ms</div>
                                    }
                                    <div class="detail">@cell.Detail</div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private static readonly string[] Operations = ["Create queue", "List queues", "Send message", "Receive message", "Delete queue"];

    // Keyed on the capability instance rather than on Provider, same reasoning as
    // ObjectStoragePage: Azure alone registers two IQueueCapability instances (Queue Storage and
    // Service Bus) under the same provider slug, and keying on the slug would let the second
    // overwrite the first in this dictionary and render one SDK's results under both headers.
    private readonly Dictionary<IQueueCapability, ComparisonCell[]> results = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.results.Clear();
        this.StateHasChanged();

        try
        {
            IReadOnlyList<IQueueCapability> queues = [.. this.Queues.OrderBy(q => CloudProvider.Order(q.Provider))];

            // No ConfigureAwait(false) here, unlike the helpers below: this await has to resume
            // back on the circuit's Dispatcher, because the finally block below calls
            // StateHasChanged(), which throws off a thread pool continuation.
            ComparisonCell[][] rows = await Task.WhenAll(queues.Select(queue => RunOneAsync(queue, this.cts.Token)));

            for (int i = 0; i < queues.Count; i++)
            {
                this.results[queues[i]] = rows[i];
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Navigated away mid-run.
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    /// <summary>
    /// One provider's column, index-aligned with <see cref="Operations"/>. Send and receive are
    /// skipped rather than attempted when the queue never got created — every provider here
    /// requires an existing queue for both, so running them anyway would just report the same
    /// failure twice. Delete runs from a finally whether or not the create reported success,
    /// cleaning up regardless of what happened to the message in between — including a cancelled
    /// run — so a run never leaks a queue into the account.
    /// </summary>
    private static async Task<ComparisonCell[]> RunOneAsync(IQueueCapability queue, CancellationToken ct)
    {
        string name = $"flocilab-cmp-{queue.Provider}-{Guid.NewGuid():N}";
        string body = $"FlociLab comparison — {queue.ServiceName} — {DateTimeOffset.UtcNow:O}";

        ComparisonCell[] cells = new ComparisonCell[Operations.Length];
        bool queueReady = false;

        try
        {
            cells[0] = await TimeAsync(queue, async () =>
            {
                await queue.CreateQueueAsync(name, ct).ConfigureAwait(false);
                queueReady = true;
                return $"Created {name}";
            }).ConfigureAwait(false);

            cells[1] = await TimeAsync(queue, async () =>
            {
                IReadOnlyList<QueueInfo> listed = await queue.ListQueuesAsync(ct).ConfigureAwait(false);

                // Once the create is green the queue provably exists, so a listing that does not
                // contain it has not achieved what an "Ok" badge claims — returning the count as a
                // string would paint a green "0 queue(s)" over exactly the routing or
                // namespace-filter mismatch this page exists to expose (§14). Only asserted when
                // queueReady: before that, listing whatever else is in the account is a legitimate
                // result.
                if (queueReady && !listed.Any(q => q.Name == name))
                {
                    throw new InvalidOperationException($"listed {listed.Count} queue(s), none of them {name}");
                }

                return $"{listed.Count} queue(s)";
            }).ConfigureAwait(false);

            if (!queueReady)
            {
                // Says which of the two it was, because they mean opposite things to a reader: an
                // unimplemented CreateQueue is a documented gap in the emulator, a failed one is a
                // problem with the run.
                string reason = cells[0].Status == CellStatus.NotImplemented
                    ? "CreateQueue is not implemented"
                    : "queue create failed";

                cells[2] = Skipped(reason);
                cells[3] = Skipped(reason);

                return cells;
            }

            cells[2] = await TimeAsync(queue, async () =>
            {
                await queue.SendMessageAsync(name, body, ct).ConfigureAwait(false);
                return $"{body.Length} char(s) sent";
            }).ConfigureAwait(false);

            cells[3] = await TimeAsync(queue, async () =>
            {
                IReadOnlyList<QueueMessage> received = await queue.ReceiveMessagesAsync(name, 1, ct).ConfigureAwait(false);

                // Both checks throw rather than reporting, for the reason in plan §14: this
                // badge is a claim that the message came back, and returning the shortfall as a
                // string paints it green. An empty receive is the exact SQS shape that row
                // records — a run that delivered nothing looking identical to one that worked.
                // The body check is the queue analogue of ObjectStoragePage's SequenceEqual: the
                // queue is created fresh per run and every capability returns only what it
                // successfully acked, so a body that differs is corruption, never a stray
                // message from somewhere else.
                if (received is not [QueueMessage message])
                {
                    throw new InvalidOperationException($"received {received.Count} message(s), expected 1");
                }

                if (!string.Equals(message.Body, body, StringComparison.Ordinal))
                {
                    throw new InvalidOperationException("message body did not round-trip");
                }

                return $"Received {message.Id}, round-trip matched";
            }).ConfigureAwait(false);
        }
        finally
        {
            // In a finally, and on CancellationToken.None rather than ct, because this is the only
            // thing standing between an abandoned run and an orphan queue. TimeAsync deliberately
            // lets OperationCanceledException escape, and Dispose() cancels ct the moment the user
            // navigates away mid-run — so without the finally the delete is skipped entirely, and
            // with the finally but on ct it would be handed an already-cancelled token and do
            // nothing. Every abandoned run would leave flocilab-cmp-* behind on all four providers.
            // Same reasoning, and the same choice, as ObjectStoragePage's cleanup step.
            //
            // Unconditional — deliberately not gated on queueReady. A create whose request landed
            // and whose response did not leaves a real queue behind, and gating cleanup on success
            // is exactly how that leak stays invisible. The cost is a red cell on a provider that
            // never created anything, which is the honest read anyway: a cleanup step is a step,
            // and one that removed nothing has not achieved what its badge claims (§14).
            cells[4] = await TimeAsync(queue, async () =>
            {
                await queue.DeleteQueueAsync(name, CancellationToken.None).ConfigureAwait(false);
                return "Deleted";
            }).ConfigureAwait(false);
        }

        return cells;
    }

    /// <summary>
    /// Times one operation and, on failure, asks the capability to classify its own SDK's
    /// exception. This page references no cloud SDK, so it cannot tell an AmazonServiceException
    /// carrying a 501 from a socket error on its own — and painting a documented 501 the same red
    /// as a genuine break is exactly what constraint 6 forbids.
    /// </summary>
    private static async Task<ComparisonCell> TimeAsync(IQueueCapability queue, Func<Task<string>> operation)
    {
        Stopwatch stopwatch = Stopwatch.StartNew();

        try
        {
            string detail = await operation().ConfigureAwait(false);

            return new ComparisonCell(CellStatus.Ok, stopwatch.Elapsed, detail);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return new ComparisonCell(FromProbe(queue.Classify(ex)), stopwatch.Elapsed, ex.Message);
        }
    }

    private static CellStatus FromProbe(ProbeStatus status) => status switch
    {
        ProbeStatus.Ok => CellStatus.Ok,
        ProbeStatus.NotImplemented => CellStatus.NotImplemented,
        ProbeStatus.Unreachable => CellStatus.Unreachable,
        _ => CellStatus.Failed,
    };

    private static ComparisonCell Skipped(string reason) => new(CellStatus.Skipped, TimeSpan.Zero, reason);

    // Deliberately the same class names /coverage uses, so a 501 looks identical on both pages.
    private static string BadgeClass(CellStatus status) => status switch
    {
        CellStatus.Ok => "badge-ok",
        CellStatus.NotImplemented => "badge-notimplemented",
        CellStatus.Unreachable or CellStatus.Skipped => "badge-unreachable",
        _ => "badge-error",
    };

    private static string StatusLabel(CellStatus status) => status switch
    {
        CellStatus.Ok => "Ok",
        CellStatus.NotImplemented => "Not implemented",
        CellStatus.Unreachable => "Unreachable",
        CellStatus.Skipped => "Skipped",
        _ => "Failed",
    };

    /// <summary>The four <see cref="ProbeStatus"/> outcomes, plus the one a probe has no notion
    /// of: an operation this page chose not to attempt.</summary>
    private enum CellStatus
    {
        Ok,
        NotImplemented,
        Unreachable,
        Failed,
        Skipped,
    }

    private sealed record ComparisonCell(CellStatus Status, TimeSpan Elapsed, string Detail);

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunOneAsync may still be inside an SDK call registered on
        // this token, and disposing underneath it throws ObjectDisposedException instead of
        // cancelling.
        this.cts.Cancel();
    }
}
