@page "/compare/secrets"
@inject IEnumerable<ISecretStoreCapability> Stores
@implements IDisposable

<PageTitle>Secrets — compare</PageTitle>

<h1>Secrets</h1>

<p class="lede">
    The same four operations — set a secret, list secrets, read the value back, delete the secret —
    run against every registered provider at once, each through its own official SDK. This page
    knows only <code>ISecretStoreCapability</code>; it never references a cloud SDK.
</p>

@{
    IReadOnlyList<ISecretStoreCapability> stores = [.. this.Stores.OrderBy(s => CloudProvider.Order(s.Provider))];
}

@if (stores.Count == 0)
{
    <p class="empty">
        No secret-store sample is registered. Each sample RCL brings its own
        <code>ISecretStoreCapability</code> with it — see docs/BLAZOR-PLAN.md §8.
    </p>
}
else
{
    <div class="toolbar">
        <button class="button" @onclick="this.RunAsync" disabled="@(this.running || !this.RendererInfo.IsInteractive)">
            @(this.running ? "Running…" : "Run on all providers")
        </button>
        @if (!this.RendererInfo.IsInteractive)
        {
            <span class="note">Waiting for the interactive circuit…</span>
        }
        else if (this.finishedAt is not null)
        {
            <span class="note">Finished @this.finishedAt.Value.ToLocalTime().ToString("HH:mm:ss")</span>
        }
    </div>

    @if (this.results.Count == 0 && !this.running)
    {
        <p class="empty">
            Nothing has run yet. Each column below is one provider's own SDK doing the same
            round-trip — a secret the run sets and, if it got that far, deletes again.
        </p>
    }
    else
    {
        <table class="grid compare">
            <thead>
                <tr>
                    <th>Operation</th>
                    @foreach (ISecretStoreCapability store in stores)
                    {
                        <th>
                            @CloudProvider.DisplayName(store.Provider)
                            <span class="note">@store.ServiceName</span>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Operations.Length; i++)
                {
                    int operationIndex = i;
                    <tr>
                        <td>@Operations[operationIndex]</td>
                        @foreach (ISecretStoreCapability store in stores)
                        {
                            ComparisonCell? cell = this.results.TryGetValue(store, out ComparisonCell[]? row)
                                ? row[operationIndex]
                                : null;
                            <td>
                                @if (cell is null)
                                {
                                    <span class="note">—</span>
                                }
                                else
                                {
                                    <span class="badge @BadgeClass(cell.Status)">@StatusLabel(cell.Status)</span>
                                    @if (cell.Status != CellStatus.Skipped)
                                    {
                                        <div class="numeric note">@cell.Elapsed.TotalMilliseconds.ToString("0") ms</div>
                                    }
                                    <div class="detail">@cell.Detail</div>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    private static readonly string[] Operations = ["Set secret", "List secrets", "Get secret", "Delete secret"];

    // Keyed on the capability instance rather than on Provider, same reasoning as
    // ObjectStoragePage and QueuesPage: a provider slug is not guaranteed to be one-to-one with a
    // registered capability, and keying on it would let a second registration silently overwrite
    // the first in this dictionary.
    private readonly Dictionary<ISecretStoreCapability, ComparisonCell[]> results = [];
    private readonly CancellationTokenSource cts = new();

    private DateTimeOffset? finishedAt;
    private bool running;
    private bool disposed;

    private async Task RunAsync()
    {
        if (this.running)
        {
            return;
        }

        this.running = true;
        this.finishedAt = null;
        this.results.Clear();
        this.StateHasChanged();

        try
        {
            IReadOnlyList<ISecretStoreCapability> stores = [.. this.Stores.OrderBy(s => CloudProvider.Order(s.Provider))];

            // No ConfigureAwait(false) here, unlike the helpers below: this await has to resume
            // back on the circuit's Dispatcher, because the finally block below calls
            // StateHasChanged(), which throws off a thread pool continuation.
            ComparisonCell[]?[] rows = await Task.WhenAll(stores.Select(store => RunOneGuardedAsync(store, this.cts.Token)));

            for (int i = 0; i < stores.Count; i++)
            {
                // Null is the one column that cancelled — the others still finished and are
                // worth rendering. See RunOneGuardedAsync.
                if (rows[i] is not null)
                {
                    this.results[stores[i]] = rows[i]!;
                }
            }

            this.finishedAt = DateTimeOffset.Now;
        }
        catch (OperationCanceledException)
        {
            // Backstop only. A cancellation raised inside a column is contained by
            // RunOneGuardedAsync so it cannot discard the other columns; this catches one raised
            // outside any of them — the Dispatcher resume itself, after Dispose().
        }
        finally
        {
            this.running = false;

            if (!this.disposed)
            {
                this.StateHasChanged();
            }
        }
    }

    /// <summary>
    /// <see cref="RunOneAsync"/> with cancellation contained to this one column.
    /// <see cref="TimeAsync"/> deliberately lets an <see cref="OperationCanceledException"/>
    /// escape so the <c>finally</c> can still clean up on <see cref="CancellationToken.None"/> —
    /// but letting it escape all the way to <c>Task.WhenAll</c> faults the whole run and discards
    /// every other provider's finished column, leaving the page silently back at "Nothing has run
    /// yet" with no error and nothing rendered.
    ///
    /// <para>
    /// That is not only the navigate-away case: several SDKs report their own client-side timeout
    /// as an <see cref="OperationCanceledException"/> subtype rather than a
    /// <see cref="TimeoutException"/> — Cosmos throws <c>CosmosOperationCanceledException</c>, and
    /// an <c>HttpClient</c> timeout surfaces as <c>TaskCanceledException</c> — so one slow
    /// provider could blank the table on the one page whose whole job is showing the columns
    /// beside each other.
    /// </para>
    /// </summary>
    private static async Task<ComparisonCell[]?> RunOneGuardedAsync(ISecretStoreCapability store, CancellationToken ct)
    {
        try
        {
            return await RunOneAsync(store, ct).ConfigureAwait(false);
        }
        catch (OperationCanceledException)
        {
            // This column gave up. Null rather than a row of Skipped cells: the run was abandoned
            // rather than decided, and a Skipped badge would claim this page chose not to try.
            return null;
        }
    }

    /// <summary>
    /// One provider's column, index-aligned with <see cref="Operations"/>. There is no separate
    /// "create the resource" row the way object storage and queues have one — <c>SetSecret</c> is
    /// the create — but that is a property of this page's four rows, not of the providers, and it
    /// is worth being precise about because the cleanup below depends on it. Only Azure's
    /// <c>SetSecret</c> is a genuine single-call upsert. AWS synthesises one from
    /// <c>PutSecretValue</c> falling back to <c>CreateSecret</c>, GCP from <c>AddSecretVersion</c>
    /// falling back to <c>CreateSecret</c> then <c>AddSecretVersion</c> again, and OCI from
    /// <c>ListSecrets</c> then <c>CreateSecret</c> or <c>UpdateSecret</c> — so for three of the
    /// four there is a window where the secret exists and the capability still threw. Get is
    /// skipped rather than attempted when the set never landed, so a provider that cannot set a
    /// secret does not also report a confusing failure trying to read one that was never written.
    /// </summary>
    private static async Task<ComparisonCell[]> RunOneAsync(ISecretStoreCapability store, CancellationToken ct)
    {
        string name = $"flocilab-cmp-{store.Provider}-{Guid.NewGuid():N}";
        string value = $"FlociLab comparison — {store.ServiceName} — {DateTimeOffset.UtcNow:O}";

        ComparisonCell[] cells = new ComparisonCell[Operations.Length];

        // Answers "did SetSecret demonstrably succeed?", and gates the read only. It deliberately
        // does *not* gate cleanup — see the finally.
        bool secretReady = false;

        try
        {
            cells[0] = await TimeAsync(store, async () =>
            {
                await store.SetSecretAsync(name, value, ct).ConfigureAwait(false);
                secretReady = true;

                return $"Set {name}";
            }).ConfigureAwait(false);

            cells[1] = await TimeAsync(store, async () =>
            {
                IReadOnlyList<SecretInfo> listed = await store.ListSecretsAsync(ct).ConfigureAwait(false);

                // Once the set is green the secret provably exists, so a listing that does not
                // contain it has not achieved what an "Ok" badge claims — returning the count as a
                // string would paint a green "0 secret(s)" over exactly the routing or
                // project/compartment-filter mismatch this page exists to expose. floci-az already
                // shows that shape on Key Vault (§14). Only asserted when secretReady: before
                // that, listing whatever else is in the account is a legitimate result.
                if (secretReady && !listed.Any(s => s.Name == name))
                {
                    throw new InvalidOperationException($"listed {listed.Count} secret(s), none of them {name}");
                }

                return $"{listed.Count} secret(s)";
            }).ConfigureAwait(false);

            if (!secretReady)
            {
                // Says which of the two it was, because they mean opposite things to a reader: an
                // unimplemented SetSecret is a documented gap in the emulator, a failed one is a
                // problem with the run.
                cells[2] = Skipped(cells[0].Status == CellStatus.NotImplemented
                    ? "SetSecret is not implemented"
                    : "secret set failed");

                return cells;
            }

            cells[2] = await TimeAsync(store, async () =>
            {
                string returned = await store.GetSecretAsync(name, ct).ConfigureAwait(false);

                // This badge is a claim that the value came back intact — the secrets analogue of
                // ObjectStoragePage's SequenceEqual and QueuesPage's body check. The secret is set
                // fresh per run, so a value that differs is corruption, never a stray secret from
                // somewhere else.
                return string.Equals(returned, value, StringComparison.Ordinal)
                    ? "Round-trip matched"
                    : throw new InvalidOperationException("secret value did not round-trip");
            }).ConfigureAwait(false);
        }
        finally
        {
            // In a finally, and on CancellationToken.None rather than ct, because this is the only
            // thing standing between an abandoned run and an orphan secret. TimeAsync deliberately
            // lets OperationCanceledException escape, and Dispose() cancels ct the moment the user
            // navigates away mid-run — so without the finally the delete is skipped entirely, and
            // with the finally but on ct it would be handed an already-cancelled token and do
            // nothing. Every abandoned run would leave flocilab-cmp-* behind on all four providers.
            //
            // Unconditional — deliberately not gated on secretReady, which is the defect this page
            // was cloned with. Three of the four capabilities synthesise their upsert from two or
            // three calls (see the remarks above), so a throw from SetSecretAsync routinely leaves
            // a real secret behind: GCP's CreateSecret can succeed and the AddSecretVersion after
            // it fail, and the container is still there. A single-call upsert whose response was
            // lost is the same shape. Gating cleanup on success is exactly how that leak stays
            // invisible. The cost is a red cell on a provider that never created anything — which
            // is the honest read anyway, because a cleanup step is a step and one that removed
            // nothing has not achieved what its badge claims (§14).
            cells[3] = await TimeAsync(store, async () =>
            {
                await store.DeleteSecretAsync(name, CancellationToken.None).ConfigureAwait(false);
                return "Deleted";
            }).ConfigureAwait(false);
        }

        return cells;
    }

    /// <summary>
    /// Times one operation and, on failure, asks the capability to classify its own SDK's
    /// exception. This page references no cloud SDK, so it cannot tell an AmazonServiceException
    /// carrying a 501 from a socket error on its own — and painting a documented 501 the same red
    /// as a genuine break is exactly what constraint 6 forbids.
    /// </summary>
    private static async Task<ComparisonCell> TimeAsync(ISecretStoreCapability store, Func<Task<string>> operation)
    {
        Stopwatch stopwatch = Stopwatch.StartNew();

        try
        {
            string detail = await operation().ConfigureAwait(false);

            return new ComparisonCell(CellStatus.Ok, stopwatch.Elapsed, detail);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            return new ComparisonCell(FromProbe(store.Classify(ex)), stopwatch.Elapsed, ex.Message);
        }
    }

    private static CellStatus FromProbe(ProbeStatus status) => status switch
    {
        ProbeStatus.Ok => CellStatus.Ok,
        ProbeStatus.NotImplemented => CellStatus.NotImplemented,
        ProbeStatus.Unreachable => CellStatus.Unreachable,
        _ => CellStatus.Failed,
    };

    private static ComparisonCell Skipped(string reason) => new(CellStatus.Skipped, TimeSpan.Zero, reason);

    // Deliberately the same class names /coverage uses, so a 501 looks identical on both pages.
    private static string BadgeClass(CellStatus status) => status switch
    {
        CellStatus.Ok => "badge-ok",
        CellStatus.NotImplemented => "badge-notimplemented",
        CellStatus.Unreachable or CellStatus.Skipped => "badge-unreachable",
        _ => "badge-error",
    };

    private static string StatusLabel(CellStatus status) => status switch
    {
        CellStatus.Ok => "Ok",
        CellStatus.NotImplemented => "Not implemented",
        CellStatus.Unreachable => "Unreachable",
        CellStatus.Skipped => "Skipped",
        _ => "Failed",
    };

    /// <summary>The four <see cref="ProbeStatus"/> outcomes, plus the one a probe has no notion
    /// of: an operation this page chose not to attempt.</summary>
    private enum CellStatus
    {
        Ok,
        NotImplemented,
        Unreachable,
        Failed,
        Skipped,
    }

    private sealed record ComparisonCell(CellStatus Status, TimeSpan Elapsed, string Detail);

    public void Dispose()
    {
        this.disposed = true;

        // Cancel without disposing: RunOneAsync may still be inside an SDK call registered on
        // this token, and disposing underneath it throws ObjectDisposedException instead of
        // cancelling.
        this.cts.Cancel();
    }
}
