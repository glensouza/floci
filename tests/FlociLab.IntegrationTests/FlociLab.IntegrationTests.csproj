<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- Test classes and fixtures are not public API; XML docs on them buy nothing. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    One test class per sample, each against a throwaway emulator, so CI needs no running stack
    (docs/BLAZOR-PLAN.md §10). This is the one project in the repo allowed to reference more than
    one provider's samples — constraint 1 is about what a sample depends on, and the point here is
    to prove every sample independently.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="Testcontainers" />
    <PackageReference Include="Testcontainers.Floci" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\FlociLab.Core\FlociLab.Core.csproj" />
    <ProjectReference Include="..\..\samples\aws\s3\FlociLab.Aws.S3.Demo\FlociLab.Aws.S3.Demo.csproj" />
    <ProjectReference Include="..\..\samples\aws\sqs\FlociLab.Aws.Sqs.Demo\FlociLab.Aws.Sqs.Demo.csproj" />
    <ProjectReference Include="..\..\samples\aws\dynamodb\FlociLab.Aws.DynamoDb.Demo\FlociLab.Aws.DynamoDb.Demo.csproj" />
    <ProjectReference Include="..\..\samples\aws\kms\FlociLab.Aws.Kms.Demo\FlociLab.Aws.Kms.Demo.csproj" />
    <ProjectReference Include="..\..\samples\aws\secretsmanager\FlociLab.Aws.SecretsManager.Demo\FlociLab.Aws.SecretsManager.Demo.csproj" />
    <ProjectReference Include="..\..\samples\azure\blob\FlociLab.Azure.Blob.Demo\FlociLab.Azure.Blob.Demo.csproj" />
    <ProjectReference Include="..\..\samples\gcp\storage\FlociLab.Gcp.Storage.Demo\FlociLab.Gcp.Storage.Demo.csproj" />
    <ProjectReference Include="..\..\samples\oci\objectstorage\FlociLab.Oci.ObjectStorage.Demo\FlociLab.Oci.ObjectStorage.Demo.csproj" />
  </ItemGroup>

</Project>
